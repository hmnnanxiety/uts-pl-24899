{
  "id": null,
  "uid": "framevault",
  "title": "FrameVault — Pemantauan Aplikasi",
  "description": "Penggunaan sumber daya, lalu lintas HTTP, dan pemeriksaan layanan FrameVault.",
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "framevault"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Berapa persen CPU yang dipakai tiap container FrameVault?",
      "description": "100% setara dengan satu core CPU logis. Setiap seri mewakili satu container.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_io_framevault_monitor=\"true\"}[1m]))",
          "legendFormat": "{{name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "axisLabel": "CPU (%)",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Berapa MiB memori yang dipakai tiap container FrameVault?",
      "description": "Working set memori tiap container, dalam MiB.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor\",container_label_io_framevault_monitor=\"true\"}) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: MiB",
          "min": 0,
          "custom": {
            "axisLabel": "Memori (MiB)",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Berapa permintaan HTTP per detik yang diterima FrameVault?",
      "description": "Laju rata-rata 5 menit dari penghitung Nginx. Mencakup halaman, aset, API, dan permintaan monitoring ke Nginx.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(nginx_http_requests_total{job=\"nginx-exporter\"}[5m])",
          "legendFormat": "HTTP FrameVault",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: req/s",
          "min": 0,
          "custom": {
            "axisLabel": "Permintaan/detik",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Apakah frontend, backend, dan database FrameVault hidup?",
      "description": "UP (1) berarti probe HTTP atau TCP berhasil. DOWN (0) berarti probe gagal. Sumbu horizontal menunjukkan waktu.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success{job=\"framevault-health\"}",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        },
        "mergeValues": true,
        "showValue": "always",
        "alignValue": "center",
        "rowHeight": 0.75
      }
    }
  ]
}
