{
  "name": "framevault-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write src tests scripts *.ts *.json index.html README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html README.md",
    "test:e2e": "playwright test",
    "demo:seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@lucide/vue": "^1.57.0",
    "axios": "^1.20.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0"
  }
}
